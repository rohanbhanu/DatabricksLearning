{
  "datasets": [
    {
      "name": "5fd6e632",
      "displayName": "Retail Sales Key Performance Indicators Summary",
      "queryLines": [
        "SELECT\r\n",
        "    MAKE_DATE(\r\n",
        "        order_year,\r\n",
        "        order_month,\r\n",
        "        1\r\n",
        "    ) AS month_date,\r\n",
        "    order_month_name,\r\n",
        "    net_sales,\r\n",
        "    gross_profit,\r\n",
        "    total_orders,\r\n",
        "    unique_customers,\r\n",
        "    avg_order_value,\r\n",
        "    profit_margin_pct\r\n",
        "FROM retail_demo.gold.monthly_sales\r\n",
        "order by order_year,order_month\r\n"
      ]
    },
    {
      "name": "22cc5e2b",
      "displayName": "ChannelVsNetSales",
      "queryLines": [
        "SELECT\r\n",
        "    sales_channel,\r\n",
        "    total_orders,\r\n",
        "    unique_customers,\r\n",
        "    units_sold,\r\n",
        "    net_sales,\r\n",
        "    gross_profit,\r\n",
        "    avg_order_value,\r\n",
        "    avg_delivery_days\r\n",
        "FROM retail_demo.gold.channel_performance\r\n",
        "ORDER BY net_sales DESC;"
      ]
    },
    {
      "name": "f17934e6",
      "displayName": "SalesByRegion",
      "queryLines": [
        "SELECT\r\n",
        "    region,\r\n",
        "\r\n",
        "    ROUND(\r\n",
        "        SUM(net_sales),\r\n",
        "        2\r\n",
        "    ) AS net_sales,\r\n",
        "\r\n",
        "    ROUND(\r\n",
        "        SUM(gross_profit),\r\n",
        "        2\r\n",
        "    ) AS gross_profit,\r\n",
        "\r\n",
        "    SUM(unique_customers) AS regional_customer_count,\r\n",
        "\r\n",
        "    ROUND(\r\n",
        "        AVG(avg_order_value),\r\n",
        "        2\r\n",
        "    ) AS avg_location_order_value,\r\n",
        "\r\n",
        "    ROUND(\r\n",
        "        AVG(avg_delivery_days),\r\n",
        "        2\r\n",
        "    ) AS avg_delivery_days\r\n",
        "\r\n",
        "FROM retail_demo.gold.regional_performance\r\n",
        "\r\n",
        "GROUP BY region\r\n",
        "\r\n",
        "ORDER BY net_sales DESC;"
      ]
    }
  ],
